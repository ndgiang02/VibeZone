# VibeZone — local development environment template.
#
#   cp .env.example .env      # then fill in every empty value
#
# .env is git-ignored. Never commit real credentials. Values here are used by
# docker-compose.yml; application settings (connection strings etc.) are wired
# from the same variables starting in M1.
#
# Generate strong values, e.g.:
#   openssl rand -hex 24
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use only [A-Za-z0-9] characters to avoid quoting issues in URLs and shells.

# --- PostgreSQL (always started) -------------------------------------------
POSTGRES_DB=vibezone
POSTGRES_USER=vibezone
POSTGRES_PASSWORD=
# Host port, bound to 127.0.0.1 only. Change if 5432 is already taken.
POSTGRES_PORT=5432

# --- Redis (profile: cache) --------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379

# --- S3-compatible object storage: MinIO (profile: media) -------------------
# Root credentials are for administration only; the application never uses them.
MINIO_ROOT_USER=vibezone-admin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Private bucket for originals, playback renditions, waveforms and artwork.
S3_BUCKET_MEDIA=vibezone-media
# Least-privilege application credentials (scoped to S3_BUCKET_MEDIA only).
# Access key: 3-20 chars. Secret key: 8-40 chars.
S3_ACCESS_KEY=vibezone-app
S3_SECRET_KEY=

# --- Application containers (profile: app) -----------------------------------
# Host ports (bound to 127.0.0.1). WEB_PORT = the site for browsers (web + /api); API_PUBLIC_PORT = the
# API-only site for native apps and integrations (ADR-0011); API_PORT = the API container directly (health, debugging).
API_PORT=5080
WEB_PORT=3000
API_PUBLIC_PORT=3001
# Production (default) or Development (enables /openapi/v1.json, readable text logs).
API_ENVIRONMENT=Production

# --- Mail catcher: Mailpit (profile: mail) -----------------------------------
# Captures verification / password-reset emails locally; nothing is delivered.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
