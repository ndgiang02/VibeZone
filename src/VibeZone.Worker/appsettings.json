{
  "Serilog": {
    "ConsoleFormat": "json",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Media": {
    "MaxConcurrentJobs": 2
  }
}
