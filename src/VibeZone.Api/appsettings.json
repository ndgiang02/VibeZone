{
  "Serilog": {
    "ConsoleFormat": "json",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Email": {
    "From": "VibeZone <no-reply@vibezone.local>",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls"
  },
  "RateLimiting": {
    "GlobalPermitsPerMinute": 600,
    "AuthPermitsPerMinute": 10
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
