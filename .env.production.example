# VibeZone — production settings template (docker-compose.prod.yml). Placeholders only; never commit real values.
#
# On the server this file is NOT copied by hand: scripts/deploy/deploy.sh writes .env from SSM Parameter Store
# (one SecureString per key under /vibezone/prod/, e.g. /vibezone/prod/POSTGRES_PASSWORD). IMAGE_TAG is set by
# the deploy itself. See docs/runbooks/deploy-aws.md.

# --- Domains & TLS -----------------------------------------------------------
WEB_DOMAIN=vibezone.example.com
API_DOMAIN=api.vibezone.example.com
# Let's Encrypt account / expiry notices.
ACME_EMAIL=ops@example.com

# --- PostgreSQL (container on the host) --------------------------------------
POSTGRES_DB=vibezone
POSTGRES_USER=vibezone
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- AWS S3 (private bucket; access via the EC2 instance role, no keys) ------
AWS_REGION=ap-southeast-1
S3_BUCKET_MEDIA=vibezone-media-prod
# Nightly pg_dump target (scripts/deploy/backup-db.sh); 14-day lifecycle rule on the bucket.
BACKUP_BUCKET=vibezone-backups-prod

# --- Email: Amazon SES SMTP ---------------------------------------------------
EMAIL_FROM=VibeZone <no-reply@vibezone.example.com>
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
# SES SMTP credentials (IAM user limited to ses:SendRawEmail).
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Images -------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/ndgiang02
