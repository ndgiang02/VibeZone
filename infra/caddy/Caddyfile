# Edge reverse proxy — the production topology from ADR-0002 (+ ADR-0011), on plain HTTP for localhost.
# Two sites:
#   WEB_SITE (browsers):  /api/*, /hubs/* → API; everything else → Next.js. Browsers see a single origin,
#                         so session/CSRF cookies stay first-party.
#   API_SITE (apps, integrations, a future gateway): /api/*, /hubs/* → API only; no web pages.
# Locally the sites are ports (:8080, :8081); in production set them to host names, e.g.
#   WEB_SITE=vibezone.vn  API_SITE=api.vibezone.vn
{
	# No admin API and no automatic HTTPS locally (TLS terminates here in real deployments).
	admin off
	auto_https off
	# Caddy is the edge: it does not trust incoming X-Forwarded-* headers (none configured), so clients
	# cannot spoof their address; it sets fresh X-Forwarded-For/Proto/Host for the upstreams.
}

(api_upstream) {
	@api path /api/* /hubs/*
	handle @api {
		# Media:MaxUploadBytes is 200 MB; the API enforces the exact limit while reading.
		request_body {
			max_size 210MB
		}
		reverse_proxy api:8080 {
			# Stream responses (audio ranges, future SignalR) without buffering.
			flush_interval -1
		}
	}
}

{$WEB_SITE::8080} {
	# Liveness for the container healthcheck (does not depend on api/web).
	handle /healthz {
		respond "ok" 200
	}

	import api_upstream

	handle {
		reverse_proxy web:3000
	}

	header -Server
}

{$API_SITE::8081} {
	import api_upstream

	handle {
		respond 404
	}

	header -Server
}
