{
  "name": "vibezone-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../../openapi/vibezone-api.json -o src/lib/api/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/lib/api/schema.d.ts",
    "ui:add": "node scripts/shadcn-add.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "8.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
